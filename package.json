{
  "name": "zperiod",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Interactive periodic table with 118 elements, 9 chemistry tools, and worksheet generator (full upstream Zhilips/Zperiod parity).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run check:syntax && npm run build",
    "check:syntax": "find . -name '*.js' -not -path './node_modules/*' -not -path './dist/*' -not -path './public/*' -print0 | xargs -0 -n1 node --check",
    "test": "node test/chemical_assertions.test.mjs"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  },
  "dependencies": {
    "driver.js": "^1.4.0",
    "marked": "^17.0.4"
  }
}
