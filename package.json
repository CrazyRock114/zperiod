{
  "name": "zperiod-clone",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify && tsc -b --noCheck && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --port 4173",
    "test": "vitest run src/lib",
    "test:watch": "vitest",
    "fix:data": "node scripts/fix-typography.mjs && node scripts/fix-chemistry.mjs && node scripts/fix-audit.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gen:registry": "node scripts/gen-i18n-registry.mjs",
    "verify": "npm run fix:data && npm run check:data && npm run check:i18n && npm run test && npm run typecheck",
    "test:all": "npm run test && npm run build && npm run test:browser",
    "test:browser": "node scripts/test-browser.mjs",
    "audit:browser": "node scripts/audit-browser.mjs",
    "serve": "node scripts/serve.mjs 4173"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
